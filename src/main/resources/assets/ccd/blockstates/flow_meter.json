{
  "multipart": [
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "ccd:block/flow_meter/body"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "ccd:block/flow_meter/body",
        "y": 90
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "ccd:block/flow_meter/body",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "ccd:block/flow_meter/head"
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "ccd:block/flow_meter/head",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "ccd:block/flow_meter/head",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "ccd:block/flow_meter/head",
        "y": 270
      }
    }
  ]
}
